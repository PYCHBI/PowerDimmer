<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <ApplicationIcon>appicon.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Only ship the framework's Chinese + English resource folders: a self-contained
         publish otherwise drags in cs/, de/, ru/, zh-Hant/ ... (~30 MB of unused text). -->
    <SatelliteResourceLanguages>en;zh-Hans</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- Single source of truth for the version shown in the About dialog, the tray menu
       and the exe's "Properties -> Details" page. Bump this when releasing. -->
  <PropertyGroup>
    <Version>1.4.0</Version>
    <AssemblyVersion>1.4.0.0</AssemblyVersion>
    <FileVersion>1.4.0.0</FileVersion>
    <Product>PowerDimmer</Product>
    <Company>PYCHBI</Company>
    <Description>Screen mask for recording and demos - dim everything except the focused window.</Description>
    <Copyright>MIT License - fork of shayne/PowerDimmer</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Hook.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ModernNotifyIcon" Version="1.2.0" />
    <PackageReference Include="NHotkey.Wpf" Version="2.1.0" />
  </ItemGroup>

</Project>
